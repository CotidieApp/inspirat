INSPIRAT_ENV=development
INSPIRAT_SECRET_KEY=change-this-to-a-random-64-character-value
INSPIRAT_DATABASE_URL=postgresql+psycopg://inspirat:inspirat_dev@postgres:5432/inspirat
INSPIRAT_REDIS_URL=redis://redis:6379/0
INSPIRAT_S3_ENDPOINT=http://minio:9000
INSPIRAT_S3_ACCESS_KEY=inspirat_dev
INSPIRAT_S3_SECRET_KEY=change-this-minio-password
INSPIRAT_S3_BUCKET=inspirat
INSPIRAT_SMTP_HOST=mailpit
INSPIRAT_SMTP_PORT=1025
# Mailpit no soporta STARTTLS: en local debe quedar en false. Con un proveedor
# real (Resend, Postmark, tu propio servidor) usa true y agrega usuario/clave.
INSPIRAT_SMTP_USE_TLS=false
INSPIRAT_SMTP_USERNAME=
INSPIRAT_SMTP_PASSWORD=
INSPIRAT_SMTP_FROM_EMAIL=no-reply@inspirat.app
INSPIRAT_SMTP_FROM_NAME=inspíraT
INSPIRAT_PUBLIC_URL=http://localhost:8000
INSPIRAT_DOMAIN=writers.example.com
INSPIRAT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
INSPIRAT_ACCESS_TOKEN_MINUTES=15
INSPIRAT_REFRESH_TOKEN_DAYS=30
POSTGRES_DB=inspirat
POSTGRES_USER=inspirat
POSTGRES_PASSWORD=inspirat_dev
MINIO_ROOT_USER=inspirat_dev
MINIO_ROOT_PASSWORD=change-this-minio-password
